{
  "name": "afterlight-launch",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/healthz", "/version"] },
  "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "LaunchWorkspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LaunchWorkspace"] }],
  "observability": { "enabled": true }
}
